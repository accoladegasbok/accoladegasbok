Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # One main address: send www.autozenithparts.com to autozenithparts.com (permanent redirect, page and
    # search words kept) so Google and customers see one copy of the site. Keep this ABOVE the other rules.
    RewriteCond %{HTTP_HOST} ^www\.autozenithparts\.com$ [NC]
    RewriteRule ^(.*)$ https://autozenithparts.com/$1 [R=301,L]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|vendor)(/.*)?$ - [F,L]

<FilesMatch "^\.env|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|webpack\.mix\.js|vite\.config\.js|README\.md$">
    Require all denied
</FilesMatch>

RewriteRule ^storage/(?!app/public/) - [F,L]